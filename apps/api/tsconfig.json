{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "strict": true,
    "paths": {
      "@petiatrics/types": ["../../packages/types/dist"],
      "@petiatrics/types/*": ["../../packages/types/dist/*"],
      "@petiatrics/config": ["../../packages/config/dist"],
      "@petiatrics/config/*": ["../../packages/config/dist/*"],
      "@petiatrics/database": ["../../packages/database/dist/src"],
      "@petiatrics/database/*": ["../../packages/database/dist/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test", "dist"]
}
