# ============================================================
# Petiatrics — Environment Variables
# Copy this file to .env and fill in all values before running.
# Never commit .env to source control.
# ============================================================

# ── Node ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=petiatrics
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=petiatrics
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public"

# ── MongoDB ───────────────────────────────────────────────
MONGO_USER=petiatrics
MONGO_PASSWORD=changeme_mongo
MONGO_URI="mongodb://${MONGO_USER}:${MONGO_PASSWORD}@localhost:27017/petiatrics?authSource=admin"

# ── Redis ─────────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis
REDIS_URL="redis://:${REDIS_PASSWORD}@localhost:6379"

# ── Session ───────────────────────────────────────────────
# Must be at least 32 characters; generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_secret_of_at_least_32_characters_long
SESSION_TTL_SECONDS=86400

# ── CORS / App URLs ───────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# ── Object Storage ────────────────────────────────────────
# URL prefix for uploaded attachments (diagnostic results, X-rays)
OBJECT_STORAGE_URL=http://localhost:9000/petiatrics
