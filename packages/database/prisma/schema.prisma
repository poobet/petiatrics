generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum SubscriptionTier {
  FREE
  STANDARD
  PREMIUM
}

enum ClinicStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
  PENDING
  REJECTED
}

enum Role {
  SUPER_ADMIN
  CLINIC_OWNER
  VET
  ASSISTANT
  CASHIER
  STAFF
  CUSTOMER
}

enum UserStatus {
  INVITED
  ACTIVE
  INACTIVE
  LOCKED
  PENDING
}

enum Locale {
  TH
  EN
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOIDED
}

enum StockMovementReason {
  DISPENSE
  REPLENISH
  MANUAL_ADJUSTMENT
  GOODS_RECEIPT
  GOODS_ISSUE
}

enum StockMovementStatus {
  COMMITTED
  PENDING_APPROVAL
  REJECTED
}

enum StockAlertType {
  LOW_STOCK
}

enum StockMovementRefType {
  VISIT_RECORD
  REPLENISHMENT
  MANUAL
}

enum ItemType {
  INVENTORY
  SERVICE
  CONSUMABLE
}

enum DefaultVatType {
  VAT_7
  VAT_EXEMPT
  NON_VAT
}

enum WhtRate {
  WHT_0
  WHT_1
  WHT_3
}

enum DispensingCategory {
  General_Retail
  Household_Remedy
  Dangerous_Drug
  Specially_Controlled_Drug
  Clinic_Use_Only
}

enum GLAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  COGS
}

enum BpType {
  CUSTOMER
  STAFF
  VET
  SUPPLIER
  OTHER
}

// 8 Infor LN partner roles — AR side (receivables) and AP side (payables)
enum BpRole {
  AR_SOLD_TO
  AR_SHIP_TO
  AR_INVOICE_TO
  AR_PAY_BY
  AP_BUY_FROM
  AP_SHIP_FROM
  AP_INVOICE_FROM
  AP_PAY_TO
}

enum InvoiceLineItemType {
  SERVICE
  PRODUCT
}

// ─── Clinic (Tenant Root) ────────────────────────────────────────────────────

model Clinic {
  id               String           @id @default(uuid())
  name             String
  slug             String           @unique
  phone            String?
  taxId            String           @unique
  address          Json             @default("{}")
  currencyCode     String           @default("THB")
  subscriptionTier SubscriptionTier @default(FREE)
  status           ClinicStatus     @default(PENDING)
  // JSONB settings: max_login_attempts, lockout_duration_minutes,
  //                 password_min_length, password_require_uppercase, password_require_number
  settings         Json             @default("{\"max_login_attempts\":5,\"lockout_duration_minutes\":15,\"password_min_length\":8,\"password_require_uppercase\":true,\"password_require_number\":true}")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  users                   User[]
  branches                Branch[]
  appointments            Appointment[]
  products                Product[]
  stockMovements          StockMovement[]
  branchStockBalances     BranchStockBalance[]
  stockAlerts             StockAlert[]
  invoices                Invoice[]
  businessPartners        BusinessPartner[]
  bpGroups                BpGroup[]
  rolePermissions         ClinicRolePermission[]
  clinicRoles             ClinicRole[]             @relation("ClinicRoles")
  purchaseOrders          PurchaseOrder[]
  goodsReceipts           GoodsReceipt[]
  purchaseInvoices        PurchaseInvoice[]
  supplierPayments        SupplierPayment[]
  documentSequenceConfigs DocumentSequenceConfig[]
  documentTypeDefinitions DocumentTypeDefinition[]
  matchingToleranceConfigs MatchingToleranceConfig[]

  @@map("clinics")
}

// ─── Branch ──────────────────────────────────────────────────────────────────

model Branch {
  id        String   @id @default(uuid())
  clinicId  String
  name      String
  code      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic                Clinic                 @relation(fields: [clinicId], references: [id])
  userBranches          UserBranch[]
  branchStockBalances   BranchStockBalance[]
  stockMovements        StockMovement[]
  goodsReceiptLines     GoodsReceiptLine[]
  productBranchSettings ProductBranchSetting[]

  @@index([clinicId])
  @@map("branches")
}

// ─── UserBranch (Join Table) ──────────────────────────────────────────────────

model UserBranch {
  userId   String
  branchId String

  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@id([userId, branchId])
  @@map("user_branches")
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id                  String     @id @default(uuid())
  clinicId            String?
  name                String     @default("")
  email               String?    @unique
  username            String?    @unique
  passwordHash        String
  pinHash             String? // Hashed supervisor PIN for POS override authorization (bcrypt)
  role                Role
  roleId              String? // FK to ClinicRole — nullable during migration
  systemRole          String? // "SUPER_ADMIN" | "CUSTOMER" | null (for clinic staff)
  status              UserStatus @default(PENDING)
  mustChangePassword  Boolean    @default(false)
  invitedBy           String?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  preferredLocale     Locale     @default(TH)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  clinic                 Clinic?           @relation(fields: [clinicId], references: [id])
  clinicRole             ClinicRole?       @relation("UserClinicRole", fields: [roleId], references: [id])
  businessPartners       BusinessPartner[]
  userBranches           UserBranch[]
  appointments           Appointment[]     @relation("VetAppointments")
  stockMovements         StockMovement[]   @relation("StockMovementActor")
  approvedStockMovements StockMovement[]   @relation("StockMovementApprover")
  createdPOs             PurchaseOrder[]   @relation("POCreatedBy")
  approvedPOs            PurchaseOrder[]   @relation("POApprovedBy")
  goodsReceipts          GoodsReceipt[]
  purchaseInvoices       PurchaseInvoice[]
  supplierPayments       SupplierPayment[]

  @@index([clinicId])
  @@index([email])
  @@index([username])
  @@map("users")
}

// ─── TaxCode (global reference — no clinicId, seeded by system) ──────────────
//
// VAT registration status of a BusinessPartner is inferred: a BP is VAT-registered
// when its defaultVatCodeId references a TaxCode where isVatType == true.
// The deprecated isVatRegistered boolean MUST NOT be re-introduced.

model TaxCode {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "VAT7", "VAT0", "WHT3", "WHT1"
  description String
  rate        Decimal  @default(0) @db.Decimal(7, 4) // percentage, e.g. 7.0000
  isVatType   Boolean  @default(false) // true = VAT code; false = WHT code
  isZeroRated Boolean  @default(false) // true = 0% rate (zero-rated exports or exempt)
  type        String   @default("VAT") // "VAT" or "WHT"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  defaultVatBps BusinessPartner[] @relation("DefaultVatCode")
  defaultWhtBps BusinessPartner[] @relation("DefaultWhtCode")
  products      Product[]         @relation("ProductDefaultTax")

  @@index([isVatType, isActive])
  @@map("tax_codes")
}

// ─── BusinessPartner ──────────────────────────────────────────────────────────
//
// Clinic-owned, tenant-scoped. Thai enterprise-grade structure.
// Soft-delete ONLY via isActive = false. Hard deletes are FORBIDDEN.
// VAT status is INFERRED from defaultVatCodeId → TaxCode.isVatType (not stored).
// Runtime invoice VAT is driven by ItemMaster — not by this BP default.

model BusinessPartner {
  id                String   @id @default(uuid())
  clinicId          String
  type              BpType
  name              String
  // Thai compliance core fields
  taxId             String? // 13-digit Thai TIN (taxpayer ID)
  isHeadOffice      Boolean  @default(true)
  branchCode        String? // 5-digit branch code for non-HO locations
  addressLine1      String?
  subDistrict       String?
  district          String?
  province          String?
  zipcode           String?
  // BP hierarchy (same clinic only)
  parentBpId        String?
  // Tax defaults (FK to global TaxCode table)
  defaultVatCodeId  String?
  defaultWhtCodeId  String?
  // Payment defaults
  creditTermDays    Int      @default(0)
  // ── Communication
  phone             String?
  email             String?
  lineId            String?
  // ── Commercial
  creditLimit       Float?
  creditHold        Boolean  @default(false)
  discountGroupId   String?
  // ── Bank account
  bankAccountName   String?
  bankAccountBranch String?
  bankAccountNumber String?
  // ── BpGroup & auto-code
  groupId           String?
  code              String?
  // ── CRM
  isMarketingOptIn  Boolean  @default(false)
  internalNotes     String?  @db.Text
  alertMessage      String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  clinic             Clinic            @relation(fields: [clinicId], references: [id])
  parentBp           BusinessPartner?  @relation("BpHierarchy", fields: [parentBpId], references: [id])
  childBps           BusinessPartner[] @relation("BpHierarchy")
  defaultVatCode     TaxCode?          @relation("DefaultVatCode", fields: [defaultVatCodeId], references: [id])
  defaultWhtCode     TaxCode?          @relation("DefaultWhtCode", fields: [defaultWhtCodeId], references: [id])
  linkedUserId       String?
  user               User?             @relation(fields: [linkedUserId], references: [id])
  vetExt             BpVet?
  suppExt            BpSupplier?
  group              BpGroup?          @relation(fields: [groupId], references: [id])
  activeRoles        BpRoleActive[]
  contacts           BpContact[]
  defaultForProducts Product[]         @relation("ProductDefaultSupplier")
  purchaseOrders     PurchaseOrder[]
  purchaseInvoices   PurchaseInvoice[]
  supplierPayments   SupplierPayment[]

  @@unique([clinicId, code])
  @@unique([clinicId, linkedUserId])
  @@index([clinicId])
  @@index([clinicId, isActive])
  @@index([clinicId, type, isActive])
  @@index([clinicId, taxId])
  @@map("business_partners")
}

// ─── BpRoleActive (junction — which LN roles this BP currently serves) ────────

model BpRoleActive {
  bpId String
  role BpRole

  bp BusinessPartner @relation(fields: [bpId], references: [id])

  @@id([bpId, role])
  @@map("bp_roles_active")
}

// ─── BpVet ────────────────────────────────────────────────────────────────────

model BpVet {
  bpId            String          @id
  licenseNumber   String          @unique
  specialty       String?
  defaultDfRate   Decimal?        @db.Decimal(5, 2)
  employmentType  EmploymentType  @default(FREELANCE)
  dfDiscountBasis DfDiscountBasis @default(AFTER_DISCOUNT)

  bp BusinessPartner @relation(fields: [bpId], references: [id])

  @@map("bp_vets")
}

// ─── BpSupplier ───────────────────────────────────────────────────────────────
// Extension-only. taxId and creditTermDays have moved to BusinessPartner core.

model BpSupplier {
  bpId          String  @id
  vendorGroupId String?

  bp BusinessPartner @relation(fields: [bpId], references: [id])

  @@map("bp_suppliers")
}

// ─── BpGroup ─────────────────────────────────────────────────────────────────

model BpGroup {
  id              String   @id @default(uuid())
  clinicId        String
  name            String
  prefix          String
  currentSequence Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clinic           Clinic            @relation(fields: [clinicId], references: [id])
  businessPartners BusinessPartner[]

  @@unique([clinicId, prefix])
  @@index([clinicId])
  @@map("bp_groups")
}

// ─── BpContact ────────────────────────────────────────────────────────────────

model BpContact {
  id        String   @id @default(uuid())
  bpId      String
  name      String
  phone     String?
  email     String?
  lineId    String?
  position  String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bp BusinessPartner @relation(fields: [bpId], references: [id])

  @@index([bpId])
  @@map("bp_contacts")
}

// ─── Appointment ─────────────────────────────────────────────────────────────

model Appointment {
  id                 String            @id @default(uuid())
  clinicId           String
  patientId          String // ObjectId ref to MongoDB PetProfile._id
  ownerUserId        String
  vetUserId          String?
  requestedAt        DateTime          @default(now())
  scheduledAt        DateTime
  durationMinutes    Int
  reason             String
  status             AppointmentStatus @default(REQUESTED)
  cancellationReason String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])
  vet    User?  @relation("VetAppointments", fields: [vetUserId], references: [id])

  @@index([clinicId])
  @@index([clinicId, vetUserId, scheduledAt])
  @@index([clinicId, ownerUserId])
  @@index([clinicId, status])
  @@index([clinicId, scheduledAt])
  @@map("appointments")
}

// ─── GLAccount (globally seeded chart of accounts) ───────────────────────────

model GLAccount {
  id        String        @id @default(uuid())
  code      String        @unique
  name      String
  type      GLAccountType
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // GL account relations for this model
  revenueForCategories   ItemCategory[] @relation("RevenueGLAccount")
  expenseForCategories   ItemCategory[] @relation("ExpenseGLAccount")
  // Product-level GL relations
  revenueProducts        Product[]      @relation("ProductRevenueAccount")
  cogsProducts           Product[]      @relation("ProductCogsAccount")
  inventoryAssetProducts Product[]      @relation("ProductInventoryAssetAccount")

  @@map("gl_accounts")
}

// ─── ItemCategory (globally seeded reference — no clinicId) ─────────────────

model ItemCategory {
  id                 String   @id @default(uuid())
  name               String   @unique
  code               String   @unique
  revenueGlAccountId String?
  expenseGlAccountId String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  products                 Product[]
  revenueGlAccount         GLAccount?                @relation("RevenueGLAccount", fields: [revenueGlAccountId], references: [id])
  expenseGlAccount         GLAccount?                @relation("ExpenseGLAccount", fields: [expenseGlAccountId], references: [id])
  matchingToleranceConfigs MatchingToleranceConfig[]

  @@map("item_categories")
}

// ─── UnitOfMeasure (globally seeded reference — no clinicId) ─────────────────

model UnitOfMeasure {
  id        String   @id @default(uuid())
  name      String   @unique
  symbol    String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  baseUnitProducts    Product[]            @relation("BaseUnit")
  itemUnitConversions ItemUnitConversion[]
  purchaseOrderLines  PurchaseOrderLine[]
  goodsReceiptLines   GoodsReceiptLine[]

  @@map("units_of_measure")
}

// ─── ItemUnitConversion (per-item alternate unit) ────────────────────────────

model ItemUnitConversion {
  id          String   @id @default(uuid())
  productId   String
  unitId      String
  ratioToBase Decimal  @db.Decimal(12, 6)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product       @relation(fields: [productId], references: [id])
  unit    UnitOfMeasure @relation(fields: [unitId], references: [id])

  @@unique([productId, unitId])
  @@index([productId])
  @@map("item_unit_conversions")
}

// ─── Product (Inventory Item) ────────────────────────────────────────────────

model Product {
  id                             String             @id @default(uuid())
  clinicId                       String
  code                           String
  sku                            String?
  barcode                        String?            @unique
  name                           String
  itemType                       ItemType           @default(INVENTORY)
  categoryId                     String?
  baseUnitId                     String?
  standardCost                   Decimal            @default(0) @db.Decimal(14, 4)
  baseSellingPrice               Decimal            @default(0) @db.Decimal(14, 4)
  isTaxInclusive                 Boolean            @default(false)
  defaultTaxCodeId               String?
  // ── Compliance & Tax (POS Dynamic Engine) ────────────────────────────────
  defaultVatType                 DefaultVatType     @default(VAT_7)
  whtRate                        WhtRate            @default(WHT_0)
  dispensingCategory             DispensingCategory @default(General_Retail)
  // ── GL Account mappings ──────────────────────────────────────────────────
  revenueAccountId               String?
  cogsAccountId                  String?
  inventoryAssetAccountId        String?
  // ── Existing fields ──────────────────────────────────────────────────────
  genericName                    String?
  isControlledSubstance          Boolean            @default(false)
  requiresBatchAndExpiryTracking Boolean            @default(false)
  defaultSupplierId              String?
  defaultDoctorFee               Decimal?           @db.Decimal(14, 4)
  quantity                       Decimal            @default(0) @db.Decimal(10, 3)
  reorderPoint                   Decimal            @default(0) @db.Decimal(10, 3)
  minimumStock                   Decimal            @default(0) @db.Decimal(10, 3)
  isActive                       Boolean            @default(true)
  createdAt                      DateTime           @default(now())
  updatedAt                      DateTime           @updatedAt

  clinic                   Clinic                 @relation(fields: [clinicId], references: [id])
  category                 ItemCategory?          @relation(fields: [categoryId], references: [id])
  baseUnit                 UnitOfMeasure?         @relation("BaseUnit", fields: [baseUnitId], references: [id])
  defaultTaxCode           TaxCode?               @relation("ProductDefaultTax", fields: [defaultTaxCodeId], references: [id])
  defaultSupplier          BusinessPartner?       @relation("ProductDefaultSupplier", fields: [defaultSupplierId], references: [id])
  // GL Account relations
  revenueAccount           GLAccount?             @relation("ProductRevenueAccount", fields: [revenueAccountId], references: [id])
  cogsAccount              GLAccount?             @relation("ProductCogsAccount", fields: [cogsAccountId], references: [id])
  inventoryAssetAccount    GLAccount?             @relation("ProductInventoryAssetAccount", fields: [inventoryAssetAccountId], references: [id])
  stockMovements           StockMovement[]
  branchStockBalances      BranchStockBalance[]
  stockAlerts              StockAlert[]
  unitConversions          ItemUnitConversion[]
  parentProductAccessories ProductAccessory[]     @relation("ParentProductRelations")
  childProductAccessories  ProductAccessory[]     @relation("ChildProductRelations")
  purchaseOrderLines       PurchaseOrderLine[]
  goodsReceiptLines        GoodsReceiptLine[]
  purchaseInvoiceLines     PurchaseInvoiceLine[]
  branchSettings           ProductBranchSetting[]

  @@unique([clinicId, code])
  @@unique([clinicId, sku])
  @@index([clinicId])
  @@index([clinicId, name])
  @@index([clinicId, itemType])
  @@index([clinicId, categoryId])
  @@index([clinicId, isActive])
  @@map("products")
}

// ─── BranchStockBalance ──────────────────────────────────────────────────────

model BranchStockBalance {
  id         String    @id @default(uuid())
  clinicId   String
  branchId   String
  productId  String
  lotNumber  String? // null = non-lot-tracked item
  expiryDate DateTime? // used for FEFO ordering
  quantity   Decimal   @default(0) @db.Decimal(10, 3)
  version    Int       @default(0) // optimistic lock counter
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  // lotNumber included; null-lot uniqueness enforced via raw SQL partial unique index in migration
  @@unique([clinicId, branchId, productId, lotNumber])
  @@index([clinicId, branchId])
  @@index([clinicId, productId])
  @@index([productId])
  @@map("branch_stock_balances")
}

// ─── ProductBranchSetting (per-branch pricing & activation) ──────────────────

model ProductBranchSetting {
  id                String   @id @default(uuid())
  productId         String
  branchId          String
  isActive          Boolean  @default(true) // Whether item is available in this branch
  retailPrice       Decimal  @db.Decimal(14, 4) // Branch-specific selling price
  movingAverageCost Decimal  @default(0) @db.Decimal(14, 4) // Branch-specific cost for COGS
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@index([branchId])
  @@map("product_branch_settings")
}

// ─── StockMovement (Immutable Ledger) ────────────────────────────────────────

model StockMovement {
  id             String               @id @default(uuid())
  clinicId       String
  branchId       String?
  productId      String
  idempotencyKey String?
  delta          Decimal              @db.Decimal(10, 3)
  quantityBefore Decimal              @db.Decimal(10, 3)
  quantityAfter  Decimal              @db.Decimal(10, 3)
  reason         StockMovementReason
  referenceType  StockMovementRefType
  referenceId    String
  actorId        String
  // Lot tracking (new)
  lotNumber      String?
  expiryDate     DateTime?
  overrideReason String? // populated on FEFO/expiry override
  reasonCode     String? // write-off classification: COUNT_DISCREPANCY, DAMAGED, EXPIRED
  approverId     String? // populated when adjustment approved
  status         StockMovementStatus  @default(COMMITTED)
  createdAt      DateTime             @default(now())

  clinic   Clinic  @relation(fields: [clinicId], references: [id])
  branch   Branch? @relation(fields: [branchId], references: [id])
  product  Product @relation(fields: [productId], references: [id])
  actor    User    @relation("StockMovementActor", fields: [actorId], references: [id])
  approver User?   @relation("StockMovementApprover", fields: [approverId], references: [id])

  @@unique([clinicId, idempotencyKey])
  @@index([clinicId])
  @@index([clinicId, branchId, createdAt])
  @@index([clinicId, productId])
  @@index([clinicId, status])
  @@map("stock_movements")
}

// ─── StockAlert ──────────────────────────────────────────────────────────────

model StockAlert {
  id          String         @id @default(uuid())
  clinicId    String
  branchId    String
  productId   String
  alertType   StockAlertType
  isActive    Boolean        @default(true)
  triggeredAt DateTime       @default(now())
  resolvedAt  DateTime?

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([clinicId, branchId, productId, alertType])
  @@index([clinicId, isActive])
  @@index([clinicId, branchId, isActive])
  @@map("stock_alerts")
}

// ─── Invoice ─────────────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(uuid())
  clinicId      String
  visitId       String? // Nullable — null = Pet Shop Retail (OTC) context
  patientId     String? // Nullable — null = OTC checkout without patient link
  ownerUserId   String? // Nullable — null = OTC checkout
  subtotalMinor Int
  taxRateBps    Int           @default(0)
  taxTotalMinor Int
  totalMinor    Int
  status        InvoiceStatus @default(DRAFT)
  issuedAt      DateTime?
  paidAt        DateTime?
  voidedAt      DateTime?
  voidReason    String?
  voidActorId   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  clinic    Clinic            @relation(fields: [clinicId], references: [id])
  lineItems InvoiceLineItem[]

  @@index([clinicId])
  @@index([clinicId, ownerUserId])
  @@index([visitId])
  @@index([clinicId, status])
  @@index([clinicId, status, createdAt])
  @@map("invoices")
}

// ─── InvoiceLineItem ─────────────────────────────────────────────────────────

model InvoiceLineItem {
  id                String              @id @default(uuid())
  invoiceId         String
  itemType          InvoiceLineItemType
  description       String
  quantity          Decimal             @db.Decimal(10, 3)
  unitPriceMinor    Int
  subtotalMinor     Int
  vatRateBps        Int                 @default(0) // basis points — context-driven (700=7%, 0=exempt)
  vatTotalMinor     Int                 @default(0) // per-line VAT amount in minor units
  sourceReferenceId String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

// ─── ProductAccessory (Parent-Child relation) ────────────────────────────────

model ProductAccessory {
  id              String   @id @default(uuid())
  parentProductId String
  childProductId  String
  quantityRatio   Decimal  @default(1.0) @db.Decimal(10, 3)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parentProduct Product @relation("ParentProductRelations", fields: [parentProductId], references: [id], onDelete: Cascade)
  childProduct  Product @relation("ChildProductRelations", fields: [childProductId], references: [id], onDelete: Cascade)

  @@unique([parentProductId, childProductId])
  @@index([parentProductId])
  @@index([childProductId])
  @@map("product_accessories")
}

model ClinicRolePermission {
  id          String   @id @default(uuid())
  clinicId    String
  role        Role
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, role])
  @@map("clinic_role_permissions")
}

// ─── Dynamic RBAC — Page & Action Masters ────────────────────────────────────

model PageMaster {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "PATIENTS", "INVENTORY"
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  actions         ActionMaster[]
  rolePermissions ClinicRolePermissionV2[]

  @@map("page_masters")
}

model ActionMaster {
  id          String   @id @default(uuid())
  pageId      String
  code        String   @unique // e.g. "PATIENT:VIEW", "INVENTORY:ADD"
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  page            PageMaster               @relation(fields: [pageId], references: [id], onDelete: Cascade)
  rolePermissions ClinicRolePermissionV2[]

  @@index([pageId])
  @@map("action_masters")
}

model ClinicRole {
  id          String   @id @default(uuid())
  clinicId    String? // null = system-level (SUPER_ADMIN, CUSTOMER)
  code        String // e.g. "CLINIC_OWNER", "VET", "CUSTOM_NURSE"
  name        String
  isSystem    Boolean  @default(false) // seeded by system; code is reserved
  isDeletable Boolean  @default(true) // false = cannot be deleted (CLINIC_OWNER)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic      Clinic?                  @relation("ClinicRoles", fields: [clinicId], references: [id], onDelete: Cascade)
  users       User[]                   @relation("UserClinicRole")
  permissions ClinicRolePermissionV2[]

  @@unique([clinicId, code])
  @@index([clinicId])
  @@map("clinic_roles")
}

model ClinicRolePermissionV2 {
  id        String   @id @default(uuid())
  roleId    String
  pageId    String
  actionId  String? // null = page-view access only
  createdAt DateTime @default(now())

  role   ClinicRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  page   PageMaster    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  action ActionMaster? @relation(fields: [actionId], references: [id], onDelete: SetNull)

  @@unique([roleId, pageId, actionId])
  @@index([roleId])
  @@index([pageId])
  @@index([actionId])
  @@map("clinic_role_permissions_v2")
}

// ─── Procurement Enums ────────────────────────────────────────────────────────

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CANCELLED
  CLOSED
}

enum GoodsReceiptStatus {
  DRAFT
  COMMITTED
  CANCELLED
}

enum PurchaseInvoiceStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  VOIDED
}

enum InvoiceMatchStatus {
  PENDING
  MATCHED
  TOLERANCE_APPROVED
  EXCEPTION
}

enum MatchDiscrepancyType {
  PRICE
  QUANTITY
  BOTH
}

// ─── Procurement Models ───────────────────────────────────────────────────────

model PurchaseOrder {
  id                 String              @id @default(uuid())
  clinicId           String
  supplierId         String
  code               String              // System-generated running number
  referenceNumber    String?             // Supplier's quotation or reference doc
  status             PurchaseOrderStatus @default(DRAFT)
  orderDate          DateTime            @default(now())
  expectedDeliveryDate DateTime?
  creditTermDays     Int                 @default(0)
  notes              String?             @db.Text

  // Financials
  subtotalMinor      Int                 @default(0)
  discountTotalMinor Int                 @default(0) // Overall discount (line + header)
  taxTotalMinor      Int                 @default(0)
  totalMinor         Int                 @default(0)

  // Auditing
  createdById        String
  approvedById       String?
  approvedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?           // Soft delete support

  // Relations
  clinic             Clinic              @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  supplier           BusinessPartner     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy          User                @relation("POCreatedBy", fields: [createdById], references: [id])
  approvedBy         User?               @relation("POApprovedBy", fields: [approvedById], references: [id])
  lines              PurchaseOrderLine[]
  goodsReceipts      GoodsReceipt[]
  purchaseInvoices   PurchaseInvoice[]

  @@unique([clinicId, code])
  @@index([clinicId, status])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String   @id @default(uuid())
  purchaseOrderId  String
  productId        String
  uomId            String?  // Alt UoM if ordered in alternate units
  quantityOrdered  Decimal  @db.Decimal(10, 3)
  quantityReceived Decimal  @default(0) @db.Decimal(10, 3)
  quantityInvoiced Decimal  @default(0) @db.Decimal(10, 3)

  // Financials
  unitPriceMinor   Int
  discountMinor    Int      @default(0) // Line-item discount in minor currency
  subtotalMinor    Int
  taxRateBps       Int      @default(0) // e.g. 700 = 7%
  taxTotalMinor    Int      @default(0)
  totalMinor       Int      @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  uom           UnitOfMeasure?        @relation(fields: [uomId], references: [id], onDelete: SetNull)
  receiptLines  GoodsReceiptLine[]
  invoiceLines  PurchaseInvoiceLine[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id              String             @id @default(uuid())
  clinicId        String
  purchaseOrderId String? // Optional for ad-hoc receipt
  code            String // e.g., "GR-2026-0001"
  status          GoodsReceiptStatus @default(DRAFT)
  receivedDate    DateTime           @default(now())
  receivedById    String
  overrideReason  String? // If over-received
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  clinic        Clinic             @relation(fields: [clinicId], references: [id])
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  receivedBy    User               @relation(fields: [receivedById], references: [id])
  lines         GoodsReceiptLine[]

  @@unique([clinicId, code])
  @@index([clinicId])
  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id               String    @id @default(uuid())
  goodsReceiptId   String
  poLineId         String?
  branchId         String // Branch-specific delivery location
  productId        String
  uomId            String?
  quantityReceived Decimal   @db.Decimal(10, 3)
  lotNumber        String?
  expiryDate       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  goodsReceipt GoodsReceipt          @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  poLine       PurchaseOrderLine?    @relation(fields: [poLineId], references: [id])
  branch       Branch                @relation(fields: [branchId], references: [id])
  product      Product               @relation(fields: [productId], references: [id])
  uom          UnitOfMeasure?        @relation(fields: [uomId], references: [id])
  invoiceLines PurchaseInvoiceLine[]

  @@index([goodsReceiptId])
  @@index([branchId])
  @@index([productId])
  @@map("goods_receipt_lines")
}

model PurchaseInvoice {
  id              String                @id @default(uuid())
  clinicId        String
  supplierId      String
  purchaseOrderId String?
  invoiceNumber   String // Vendor's invoice number
  code            String // e.g., "PI-2026-0001"
  status          PurchaseInvoiceStatus @default(DRAFT)
  matchStatus     InvoiceMatchStatus    @default(PENDING)
  invoiceDate     DateTime
  dueDate         DateTime
  subtotalMinor   Int                   @default(0)
  taxTotalMinor   Int                   @default(0)
  totalMinor      Int                   @default(0)
  amountPaidMinor Int                   @default(0)
  createdById     String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  clinic        Clinic                      @relation(fields: [clinicId], references: [id])
  supplier      BusinessPartner             @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder?              @relation(fields: [purchaseOrderId], references: [id])
  createdBy     User                        @relation(fields: [createdById], references: [id])
  lines         PurchaseInvoiceLine[]
  allocations   SupplierPaymentAllocation[]

  @@unique([clinicId, code])
  @@index([clinicId])
  @@index([supplierId])
  @@map("purchase_invoices")
}

model PurchaseInvoiceLine {
  id                String   @id @default(uuid())
  purchaseInvoiceId String
  poLineId          String?
  grLineId          String?
  productId         String
  quantity          Decimal  @db.Decimal(10, 3)
  unitPriceMinor    Int
  subtotalMinor     Int
  taxRateBps        Int      @default(0)
  taxTotalMinor     Int      @default(0)
  totalMinor        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  purchaseInvoice PurchaseInvoice    @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  poLine          PurchaseOrderLine? @relation(fields: [poLineId], references: [id])
  grLine          GoodsReceiptLine?  @relation(fields: [grLineId], references: [id])
  product         Product            @relation(fields: [productId], references: [id])

  @@index([purchaseInvoiceId])
  @@map("purchase_invoice_lines")
}

model SupplierPayment {
  id              String   @id @default(uuid())
  clinicId        String
  supplierId      String
  code            String // e.g., "SP-2026-0001"
  paymentDate     DateTime @default(now())
  paymentMethod   String // e.g., "BANK_TRANSFER", "CASH"
  referenceNumber String?
  amountMinor     Int
  whtAmountMinor  Int      @default(0)
  whtRateBps      Int      @default(0) // e.g. 100 = 1%, 300 = 3%
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clinic      Clinic                      @relation(fields: [clinicId], references: [id])
  supplier    BusinessPartner             @relation(fields: [supplierId], references: [id])
  createdBy   User                        @relation(fields: [createdById], references: [id])
  allocations SupplierPaymentAllocation[]

  @@unique([clinicId, code])
  @@index([clinicId])
  @@index([supplierId])
  @@map("supplier_payments")
}

model SupplierPaymentAllocation {
  id                   String   @id @default(uuid())
  paymentId            String
  purchaseInvoiceId    String
  amountAllocatedMinor Int
  createdAt            DateTime @default(now())

  payment SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([purchaseInvoiceId])
  @@map("supplier_payment_allocations")
}

// ─── Document Sequencing ─────────────────────────────────────────────────────

enum SequenceScope {
  CLINIC
  BRANCH
}

enum ResetInterval {
  YEARLY
  MONTHLY
  DAILY
  NEVER
}

// Registry of document types (system built-ins + clinic-custom)
model DocumentTypeDefinition {
  id                   String        @id @default(uuid())
  clinicId             String? // null = system-wide built-in
  code                 String // e.g. "PURCHASE_ORDER", "MY_CUSTOM_DOC"
  label                String // e.g. "Purchase Order"
  defaultTemplate      String // e.g. "PO{yyyy}-{number:4}"
  defaultResetInterval ResetInterval @default(YEARLY)
  scope                SequenceScope @default(CLINIC)
  isSystem             Boolean       @default(false)
  isActive             Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, code])
  @@index([clinicId])
  @@map("document_type_definitions")
}

model DocumentSequenceConfig {
  id            String        @id @default(uuid())
  clinicId      String
  documentType  String // references DocumentTypeDefinition.code
  template      String // e.g. "PO{yyyy}-{number:4}"
  resetInterval ResetInterval @default(YEARLY)
  scope         SequenceScope @default(CLINIC)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, documentType])
  @@index([clinicId])
  @@map("document_sequence_configs")
}

model DocumentSequence {
  id           String   @id @default(uuid())
  clinicId     String
  branchId     String   @default("CLINIC")
  documentType String // references DocumentTypeDefinition.code
  period       String // "2026", "2026-07", "2026-07-11", or "GLOBAL"
  lastNumber   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([clinicId, branchId, documentType, period])
  @@index([clinicId])
  @@map("document_sequences")
}

// ─── Matching Tolerance Configuration ────────────────────────────────────────

model MatchingToleranceConfig {
  id               String   @id @default(uuid())
  clinicId         String
  categoryId       String?  // null = default for all categories
  tolerancePercent Decimal  @default(2.0) @db.Decimal(5, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  clinic   Clinic        @relation(fields: [clinicId], references: [id])
  category ItemCategory? @relation(fields: [categoryId], references: [id])

  @@unique([clinicId, categoryId])
  @@index([clinicId])
  @@map("matching_tolerance_configs")
}

// ─── Commission Engine Enums & Models ──────────────────────────────────────────

enum CommissionType {
  PERCENTAGE
  FLAT_RATE
}

enum DfTransactionStatus {
  ACCRUED
  CONFIRMED
  SETTLED
  VOIDED
}

enum DfPaymentRunStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

enum EmploymentType {
  FREELANCE
  EMPLOYEE
}

enum DfDiscountBasis {
  BEFORE_DISCOUNT
  AFTER_DISCOUNT
}

model CommissionRule {
  id                String         @id @default(uuid())
  clinicId          String
  businessPartnerId String
  productId         String?
  commissionType    CommissionType
  rate              Decimal        @db.Decimal(7, 4)
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([clinicId, businessPartnerId, productId])
  @@index([clinicId, businessPartnerId])
  @@map("commission_rules")
}

model DfTransaction {
  id                  String              @id @default(uuid())
  clinicId            String
  branchId            String
  businessPartnerId   String
  visitId             String?
  invoiceId           String?
  invoiceLineItemId   String?
  productId           String?

  revenueAmountMinor  Int
  commissionType      CommissionType
  commissionRate      Decimal             @db.Decimal(7, 4)
  dfAmountMinor       Int
  whtRate             Decimal             @default(0) @db.Decimal(5, 4)
  whtAmountMinor      Int                 @default(0)
  netPayableMinor     Int

  status              DfTransactionStatus @default(ACCRUED)
  accruedAt           DateTime            @default(now())
  confirmedAt         DateTime?
  settledAt           DateTime?
  voidedAt            DateTime?
  voidReason          String?

  paymentAllocationId String?
  idempotencyKey      String?

  createdAt           DateTime            @default(now())

  @@unique([clinicId, idempotencyKey])
  @@index([clinicId, businessPartnerId, status])
  @@index([clinicId, branchId, status])
  @@index([clinicId, invoiceId])
  @@index([clinicId, status, accruedAt])
  @@map("df_transactions")
}

model DfPaymentRun {
  id                String             @id @default(uuid())
  clinicId          String
  code              String
  businessPartnerId String
  periodStart       DateTime
  periodEnd         DateTime

  totalDfMinor      Int
  totalWhtMinor     Int
  totalNetMinor     Int

  paymentMethod     String?
  referenceNumber   String?
  status            DfPaymentRunStatus @default(DRAFT)

  approvedById      String?
  approvedAt        DateTime?
  paidAt            DateTime?
  createdById       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  allocations       DfPaymentAllocation[]

  @@unique([clinicId, code])
  @@index([clinicId, businessPartnerId])
  @@index([clinicId, status])
  @@map("df_payment_runs")
}

model DfPaymentAllocation {
  id              String   @id @default(uuid())
  paymentRunId    String
  dfTransactionId String
  amountMinor     Int
  createdAt       DateTime @default(now())

  paymentRun DfPaymentRun @relation(fields: [paymentRunId], references: [id], onDelete: Cascade)

  @@index([paymentRunId])
  @@index([dfTransactionId])
  @@map("df_payment_allocations")
}

model WHTCertificate {
  id                String   @id @default(uuid())
  clinicId          String
  code              String
  businessPartnerId String
  paymentRunId      String?

  payerTaxId        String
  payerName         String
  payerAddress      String

  payeeTaxId        String
  payeeName         String
  payeeAddress      String

  incomeType        String
  incomeDescription String
  totalIncomeMinor  Int
  whtRateBps        Int
  whtAmountMinor    Int

  taxMonth          Int
  taxYear           Int

  issuedAt          DateTime           @default(now())
  createdAt         DateTime           @default(now())

  @@unique([clinicId, code])
  @@index([clinicId, businessPartnerId])
  @@index([clinicId, taxYear, taxMonth])
  @@map("wht_certificates")
}
