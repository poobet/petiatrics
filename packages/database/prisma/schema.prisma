generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum SubscriptionTier {
  FREE
  STANDARD
  PREMIUM
}

enum ClinicStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
  PENDING
  REJECTED
}

enum Role {
  SUPER_ADMIN
  CLINIC_OWNER
  VET
  ASSISTANT
  CASHIER
  STAFF
}

enum UserStatus {
  INVITED
  ACTIVE
  INACTIVE
  LOCKED
  PENDING
}

enum Locale {
  TH
  EN
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOIDED
}

enum StockMovementReason {
  DISPENSE
  REPLENISH
  MANUAL_ADJUSTMENT
}

enum StockMovementRefType {
  VISIT_RECORD
  REPLENISHMENT
  MANUAL
}

enum ItemType {
  STOCKED_GOOD
  SERVICE
}

enum BpType {
  CUSTOMER
  STAFF
  VET
  SUPPLIER
  OTHER
}

// 8 Infor LN partner roles — AR side (receivables) and AP side (payables)
enum BpRole {
  AR_SOLD_TO
  AR_SHIP_TO
  AR_INVOICE_TO
  AR_PAY_BY
  AP_BUY_FROM
  AP_SHIP_FROM
  AP_INVOICE_FROM
  AP_PAY_TO
}

enum InvoiceLineItemType {
  SERVICE
  PRODUCT
}

// ─── Clinic (Tenant Root) ────────────────────────────────────────────────────

model Clinic {
  id               String           @id @default(uuid())
  name             String
  slug             String           @unique
  phone            String?
  taxId            String           @unique
  address          Json             @default("{}")
  currencyCode     String           @default("THB")
  subscriptionTier SubscriptionTier @default(FREE)
  status           ClinicStatus     @default(PENDING)
  // JSONB settings: max_login_attempts, lockout_duration_minutes,
  //                 password_min_length, password_require_uppercase, password_require_number
  settings         Json             @default("{\"max_login_attempts\":5,\"lockout_duration_minutes\":15,\"password_min_length\":8,\"password_require_uppercase\":true,\"password_require_number\":true}")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  users               User[]
  branches            Branch[]
  appointments        Appointment[]
  products            Product[]
  stockMovements      StockMovement[]
  branchStockBalances BranchStockBalance[]
  invoices            Invoice[]
  businessPartners    BusinessPartner[]
  bpGroups            BpGroup[]

  @@map("clinics")
}

// ─── Branch ──────────────────────────────────────────────────────────────────

model Branch {
  id        String   @id @default(uuid())
  clinicId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic            Clinic              @relation(fields: [clinicId], references: [id])
  userBranches      UserBranch[]
  branchStockBalances BranchStockBalance[]
  stockMovements    StockMovement[]

  @@index([clinicId])
  @@map("branches")
}

// ─── UserBranch (Join Table) ──────────────────────────────────────────────────

model UserBranch {
  userId   String
  branchId String

  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@id([userId, branchId])
  @@map("user_branches")
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id                  String     @id @default(uuid())
  clinicId            String?
  businessPartnerId   String?    @unique
  name                String     @default("")
  email               String?    @unique
  username            String?    @unique
  passwordHash        String
  role                Role
  status              UserStatus @default(PENDING)
  mustChangePassword  Boolean    @default(false)
  invitedBy           String?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  preferredLocale     Locale     @default(TH)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  clinic          Clinic?          @relation(fields: [clinicId], references: [id])
  businessPartner BusinessPartner? @relation(fields: [businessPartnerId], references: [id])
  userBranches    UserBranch[]
  appointments    Appointment[]    @relation("VetAppointments")

  @@index([clinicId])
  @@index([email])
  @@index([username])
  @@map("users")
}

// ─── TaxCode (global reference — no clinicId, seeded by system) ──────────────
//
// VAT registration status of a BusinessPartner is inferred: a BP is VAT-registered
// when its defaultVatCodeId references a TaxCode where isVatType == true.
// The deprecated isVatRegistered boolean MUST NOT be re-introduced.

model TaxCode {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "VAT7", "VAT0", "WHT3", "WHT1"
  description String
  rate        Decimal  @default(0) @db.Decimal(7, 4) // percentage, e.g. 7.0000
  isVatType   Boolean  @default(false)               // true = VAT code; false = WHT code
  isZeroRated Boolean  @default(false)               // true = 0% rate (zero-rated exports or exempt)
  type        String   @default("VAT")               // "VAT" or "WHT"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  defaultVatBps BusinessPartner[] @relation("DefaultVatCode")
  defaultWhtBps BusinessPartner[] @relation("DefaultWhtCode")
  products      Product[]         @relation("ProductDefaultTax")

  @@index([isVatType, isActive])
  @@map("tax_codes")
}

// ─── BusinessPartner ──────────────────────────────────────────────────────────
//
// Clinic-owned, tenant-scoped. Thai enterprise-grade structure.
// Soft-delete ONLY via isActive = false. Hard deletes are FORBIDDEN.
// VAT status is INFERRED from defaultVatCodeId → TaxCode.isVatType (not stored).
// Runtime invoice VAT is driven by ItemMaster — not by this BP default.

model BusinessPartner {
  id               String   @id @default(uuid())
  clinicId         String
  type             BpType
  name             String
  // Thai compliance core fields
  taxId            String?  // 13-digit Thai TIN (taxpayer ID)
  isHeadOffice     Boolean  @default(true)
  branchCode       String?  // 5-digit branch code for non-HO locations
  addressLine1     String?
  subDistrict      String?
  district         String?
  province         String?
  zipcode          String?
  // BP hierarchy (same clinic only)
  parentBpId       String?
  // Tax defaults (FK to global TaxCode table)
  defaultVatCodeId String?
  defaultWhtCodeId String?
  // Payment defaults
  creditTermDays   Int      @default(0)
  // ── Communication
  phone            String?
  email            String?
  lineId           String?
  // ── Commercial
  creditLimit      Float?
  creditHold       Boolean  @default(false)
  discountGroupId  String?
  // ── Bank account
  bankAccountName   String?
  bankAccountBranch String?
  bankAccountNumber String?
  // ── BpGroup & auto-code
  groupId          String?
  code             String?
  // ── CRM
  isMarketingOptIn Boolean  @default(false)
  internalNotes    String?  @db.Text
  alertMessage     String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  clinic         Clinic          @relation(fields: [clinicId], references: [id])
  parentBp       BusinessPartner?  @relation("BpHierarchy", fields: [parentBpId], references: [id])
  childBps       BusinessPartner[] @relation("BpHierarchy")
  defaultVatCode TaxCode?        @relation("DefaultVatCode", fields: [defaultVatCodeId], references: [id])
  defaultWhtCode TaxCode?        @relation("DefaultWhtCode", fields: [defaultWhtCodeId], references: [id])
  user           User?
  vetExt         BpVet?
  suppExt        BpSupplier?
  group          BpGroup?        @relation(fields: [groupId], references: [id])
  activeRoles    BpRoleActive[]
  contacts       BpContact[]
  defaultForProducts Product[]   @relation("ProductDefaultSupplier")

  @@unique([clinicId, code])
  @@index([clinicId])
  @@index([clinicId, isActive])
  @@index([clinicId, type, isActive])
  @@index([clinicId, taxId])
  @@map("business_partners")
}

// ─── BpRoleActive (junction — which LN roles this BP currently serves) ────────

model BpRoleActive {
  bpId String
  role BpRole

  bp BusinessPartner @relation(fields: [bpId], references: [id])

  @@id([bpId, role])
  @@map("bp_roles_active")
}

// ─── BpVet ────────────────────────────────────────────────────────────────────

model BpVet {
  bpId          String          @id
  licenseNumber String          @unique
  specialty     String?
  defaultDfRate Decimal?        @db.Decimal(5,2)

  bp BusinessPartner @relation(fields: [bpId], references: [id])

  @@map("bp_vets")
}

// ─── BpSupplier ───────────────────────────────────────────────────────────────
// Extension-only. taxId and creditTermDays have moved to BusinessPartner core.

model BpSupplier {
  bpId          String  @id
  vendorGroupId String?

  bp BusinessPartner @relation(fields: [bpId], references: [id])

  @@map("bp_suppliers")
}

// ─── BpGroup ─────────────────────────────────────────────────────────────────

model BpGroup {
  id              String   @id @default(uuid())
  clinicId        String
  name            String
  prefix          String
  currentSequence Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clinic           Clinic            @relation(fields: [clinicId], references: [id])
  businessPartners BusinessPartner[]

  @@unique([clinicId, prefix])
  @@index([clinicId])
  @@map("bp_groups")
}

// ─── BpContact ────────────────────────────────────────────────────────────────

model BpContact {
  id        String           @id @default(uuid())
  bpId      String
  name      String
  phone     String?
  email     String?
  lineId    String?
  position  String?
  isPrimary Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  bp BusinessPartner @relation(fields: [bpId], references: [id])

  @@index([bpId])
  @@map("bp_contacts")
}

// ─── Appointment ─────────────────────────────────────────────────────────────

model Appointment {
  id                 String            @id @default(uuid())
  clinicId           String
  patientId          String            // ObjectId ref to MongoDB PetProfile._id
  ownerUserId        String
  vetUserId          String?
  requestedAt        DateTime          @default(now())
  scheduledAt        DateTime
  durationMinutes    Int
  reason             String
  status             AppointmentStatus @default(REQUESTED)
  cancellationReason String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])
  vet    User?  @relation("VetAppointments", fields: [vetUserId], references: [id])

  @@index([clinicId])
  @@index([clinicId, vetUserId, scheduledAt])
  @@index([clinicId, ownerUserId])
  @@index([clinicId, status])
  @@index([clinicId, scheduledAt])
  @@map("appointments")
}

// ─── ItemCategory (globally seeded reference — no clinicId) ─────────────────

model ItemCategory {
  id            String   @id @default(uuid())
  name          String   @unique
  code          String   @unique
  revenueGlCode String?
  expenseGlCode String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products Product[]

  @@map("item_categories")
}

// ─── UnitOfMeasure (globally seeded reference — no clinicId) ─────────────────

model UnitOfMeasure {
  id        String   @id @default(uuid())
  name      String   @unique
  symbol    String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  baseUnitProducts   Product[]            @relation("BaseUnit")
  itemUnitConversions ItemUnitConversion[]

  @@map("units_of_measure")
}

// ─── ItemUnitConversion (per-item alternate unit) ────────────────────────────

model ItemUnitConversion {
  id          String        @id @default(uuid())
  productId   String
  unitId      String
  ratioToBase Decimal       @db.Decimal(12, 6)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  product Product       @relation(fields: [productId], references: [id])
  unit    UnitOfMeasure @relation(fields: [unitId], references: [id])

  @@unique([productId, unitId])
  @@index([productId])
  @@map("item_unit_conversions")
}

// ─── Product (Inventory Item) ────────────────────────────────────────────────

model Product {
  id                            String    @id @default(uuid())
  clinicId                      String
  code                          String
  name                          String
  itemType                      ItemType  @default(STOCKED_GOOD)
  categoryId                    String?
  baseUnitId                    String?
  standardCost                  Decimal   @default(0) @db.Decimal(14, 4)
  baseSellingPrice              Decimal   @default(0) @db.Decimal(14, 4)
  isTaxInclusive                Boolean   @default(false)
  defaultTaxCodeId              String?
  genericName                   String?
  isControlledSubstance         Boolean   @default(false)
  requiresBatchAndExpiryTracking Boolean  @default(false)
  defaultSupplierId             String?
  defaultDoctorFee              Decimal?  @db.Decimal(14, 4)
  quantity                      Decimal   @default(0) @db.Decimal(10, 3)
  reorderThreshold              Decimal   @default(0) @db.Decimal(10, 3)
  isActive                      Boolean   @default(true)
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  clinic          Clinic              @relation(fields: [clinicId], references: [id])
  category        ItemCategory?       @relation(fields: [categoryId], references: [id])
  baseUnit        UnitOfMeasure?      @relation("BaseUnit", fields: [baseUnitId], references: [id])
  defaultTaxCode  TaxCode?            @relation("ProductDefaultTax", fields: [defaultTaxCodeId], references: [id])
  defaultSupplier BusinessPartner?    @relation("ProductDefaultSupplier", fields: [defaultSupplierId], references: [id])
  stockMovements      StockMovement[]
  branchStockBalances BranchStockBalance[]
  unitConversions     ItemUnitConversion[]

  @@unique([clinicId, code])
  @@index([clinicId])
  @@index([clinicId, name])
  @@index([clinicId, itemType])
  @@index([clinicId, categoryId])
  @@index([clinicId, isActive])
  @@map("products")
}

// ─── BranchStockBalance ──────────────────────────────────────────────────────

model BranchStockBalance {
  id        String   @id @default(uuid())
  clinicId  String
  branchId  String
  productId String
  quantity  Decimal  @default(0) @db.Decimal(10, 3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([clinicId, branchId, productId])
  @@index([clinicId, branchId])
  @@index([productId])
  @@map("branch_stock_balances")
}

// ─── StockMovement (Immutable Ledger) ────────────────────────────────────────

model StockMovement {
  id             String               @id @default(uuid())
  clinicId       String
  branchId       String?
  productId      String
  idempotencyKey String?
  delta          Decimal              @db.Decimal(10, 3)
  quantityBefore Decimal              @db.Decimal(10, 3)
  quantityAfter  Decimal              @db.Decimal(10, 3)
  reason         StockMovementReason
  referenceType  StockMovementRefType
  referenceId    String
  actorId        String
  createdAt      DateTime             @default(now())

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  branch  Branch? @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([clinicId, idempotencyKey])
  @@index([clinicId])
  @@index([clinicId, branchId, createdAt])
  @@index([clinicId, productId])
  @@map("stock_movements")
}

// ─── Invoice ─────────────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(uuid())
  clinicId      String
  visitId       String        // MongoDB VisitRecord._id
  patientId     String        // MongoDB PetProfile._id
  ownerUserId   String
  subtotalMinor Int
  taxRateBps    Int           @default(0) // basis points, e.g. 700 = 7%
  taxTotalMinor Int
  totalMinor    Int
  status        InvoiceStatus @default(DRAFT)
  issuedAt      DateTime?
  paidAt        DateTime?
  voidedAt      DateTime?
  voidReason    String?
  voidActorId   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  clinic    Clinic            @relation(fields: [clinicId], references: [id])
  lineItems InvoiceLineItem[]

  @@index([clinicId])
  @@index([clinicId, ownerUserId])
  @@index([visitId])
  @@index([clinicId, status])
  @@index([clinicId, status, createdAt])
  @@map("invoices")
}

// ─── InvoiceLineItem ─────────────────────────────────────────────────────────

model InvoiceLineItem {
  id                String              @id @default(uuid())
  invoiceId         String
  itemType          InvoiceLineItemType
  description       String
  quantity          Decimal             @db.Decimal(10, 3)
  unitPriceMinor    Int
  subtotalMinor     Int
  sourceReferenceId String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}
